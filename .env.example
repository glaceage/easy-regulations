# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/easy_regulations

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=easy-regulations
MINIO_REGION=us-east-1

# Xiaomi LLM（OpenAI 兼容网关）
# 未配置 XIAOMI_API_KEY 时，dev 环境自动使用本地模拟建议（无需联网）
XIAOMI_BASE_URL=https://api.xiaomi.com/v1
XIAOMI_API_KEY=
XIAOMI_MODEL=MiMo-V2.5-Pro
LLM_TIMEOUT_SECONDS=120
# LLM_DEV_MOCK=1
# Deepseek LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Auth: dev | ldap
AUTH_MODE=dev
